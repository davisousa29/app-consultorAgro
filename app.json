{
  "expo": {
    "name": "Colchete - Consultor",
    "slug": "colchete-consultor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.colchete.consultor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.colchete.consultor"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "colchete-consultor",
    "extra": {
      "apiUrl": "http://localhost/api",
      "googleWebClientId": "SEU_WEB_CLIENT_ID.apps.googleusercontent.com",
      "googleIosClientId": "SEU_IOS_CLIENT_ID.apps.googleusercontent.com"
    }
  }
}
